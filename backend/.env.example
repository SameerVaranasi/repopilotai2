# RepoPilot — backend environment variables
# Copy this file to `.env` in the same folder as repopilot_api.py and fill in the values.
# Never commit a real `.env` to git.

# --- GitHub (optional, recommended) ---
# Set a personal access token to lift the anonymous 60-requests/hour GitHub rate limit.
# The backend inherits this at startup; the value is never returned by any API endpoint.
GITHUB_TOKEN=

# --- Google Gemini (required for the /chat endpoint) ---
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model to call. Defaults to gemini-2.0-flash if unset.
# Other valid options: gemini-2.0-pro, gemini-1.5-flash, gemini-1.5-pro.
GEMINI_MODEL=gemini-2.0-flash

# Hard cap on the number of input characters sent to Gemini per chat turn.
# ~30k chars is roughly 8k tokens, well within gemini-2.0-flash's 1M context window
# and keeps a single runaway conversation from blowing the daily free-tier quota.
GEMINI_MAX_CONTEXT_CHARS=30000

# Maximum number of conversation turns (user+assistant pairs) to retain for context.
GEMINI_MAX_HISTORY_TURNS=6
